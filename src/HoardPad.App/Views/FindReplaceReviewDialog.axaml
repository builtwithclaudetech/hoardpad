<!--
  FindReplaceReviewDialog.axaml — the FR-18 in-folder replace REVIEW modal (design §3.5).

  A real modal Window shown via ShowDialog(owner): the per-file match list the user reviews BEFORE any
  write (review-before-write, FR-18 / OQ-2). Each row has an include/exclude checkbox + a match→replace
  count; the summary line totals matches/files and what will actually be replaced. [Apply] writes only the
  checked files (atomically, through IAtomicFileStore); Cancel writes nothing. Cancel takes initial focus
  (an accidental Enter must not commit a multi-file disk change). Chrome uses the brand.md §13 tokens.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HoardPad.App.Views"
        x:Class="HoardPad.App.Views.FindReplaceReviewDialog"
        Width="600" Height="380"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brand.Surface.Brush}"
        FontFamily="{DynamicResource Brand.Font.Ui}"
        FontSize="{DynamicResource Brand.Font.UiSize}"
        Title="In-folder replace — review before applying">

  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">

    <TextBlock Grid.Row="0"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brand.OnSurface.Brush}"
               Text="In-folder replace — review before applying" />

    <!-- The per-file review list. Each row: an include/exclude checkbox, the relative path, the count. -->
    <Border Grid.Row="1"
            BorderBrush="{DynamicResource Brand.OverlaySurface.Brush}"
            BorderThickness="1"
            CornerRadius="3">
      <ScrollViewer>
        <ItemsControl x:Name="FileList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:FindReplaceReviewRow">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4" ColumnSpacing="8">
                <CheckBox Grid.Column="0" IsChecked="{Binding Included}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding Label}"
                           Foreground="{DynamicResource Brand.OnSurface.Brush}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="{Binding CountLabel}"
                           Foreground="{DynamicResource Brand.Muted.Brush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2"
               x:Name="SummaryText"
               Foreground="{DynamicResource Brand.Muted.Brush}"
               Text="" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>

  </Grid>
</Window>
