<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- DragonScrub is not on nuget.org, so it is vendored in this repository:
       ./packages/DragonScrub.0.2.0.nupkg, resolved through the "vendored" folder
       feed below (the path is relative to this file). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vendored" value="./packages" />
  </packageSources>

  <!-- Source mapping (dependency-confusion guard): DragonScrub resolves ONLY from the
       vendored folder, every other package ONLY from nuget.org. NuGet picks the most
       specific matching pattern, so the exact "DragonScrub" entry wins over "*".
       Works with Central Package Management: the mapping is keyed on the package id,
       and the version stays pinned in Directory.Packages.props. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vendored">
      <package pattern="DragonScrub" />
    </packageSource>
  </packageSourceMapping>
</configuration>
